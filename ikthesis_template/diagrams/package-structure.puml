@startuml package-structure
left to right direction

skinparam backgroundColor #FFFFFF
skinparam dpi 190
skinparam defaultFontSize 18
skinparam packageStyle rectangle
skinparam defaultTextAlignment left
skinparam package {
  BorderColor #3F51B5
  BackgroundColor #EEF1FB
  FontSize 16
  FontColor #1A237E
}
skinparam rectangle {
  BorderColor #3F51B5
  BackgroundColor #FFFFFF
  FontSize 16
}

scale 1.4

skinparam titleFontSize 22

title Module and Package Structure 

package "com.solar" {
  ' Row 1
  together {
    package "user_management" #C5CAE9 {
      rectangle "controller (3)\nservice (3) + impl (4)\nrepository (2)\nmodel (2)\nsecurity (7)\nconfig (2)\ndto: auth (4), user (4), customer (1)" as um_summary
    }
    package "energy_monitoring" #90CAF9 {
      rectangle "controller (3)\nservice (5) + impl (3)\nrepository (3)\nmodel (3)\nconfig (3)\ndto (14)" as em_summary
    }
    package "payment_compliance" #81C784 {
      rectangle "controller (3)\nservice (7) + impl (8)\nrepository (5)\nmodel (5)\ndto (8)" as pc_summary
    }
  }

  ' Row 2
  together {
    package "tampering_detection" #FFAB91 {
      rectangle "controller (5)\nservice (5) + impl (5)\nrepository (5)\nmodel (5)\nconfig (1)\nscheduler (1)\ndto (7)" as td_summary
    }
    package "service_control" #CE93D8 {
      rectangle "controller (5)\nservice (9) + impl (8)\nrepository (4)\nmodel (4)\ndto (10)" as sc_summary
    }
    package "common" #FFE0B2 {
      rectangle "platform config (2) [com.solar.config]\ncore config (1) [com.solar.core_services.config]\nexception (2)" as common_summary
    }
  }
}

legend right
Counts are derived from src/main/java/com/solar/** at commit time.\n
Each module shows key subpackages and their Java file counts.\n
For class-level details, see per-module diagrams.
endlegend

@enduml
