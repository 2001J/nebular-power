@startuml system-architecture
!define RECTANGLE class

scale 1.3
skinparam dpi 200
skinparam componentStyle rectangle
skinparam backgroundColor #FFFFFF
skinparam component {
    BackgroundColor<<presentation>> #E1F5FF
    BackgroundColor<<application>> #FFF9C4
    BackgroundColor<<persistence>> #F0F4C3
    BorderColor #455A64
    FontSize 12
}

package "Presentation Layer" <<presentation>> {
    component "Next.js 15 Frontend" as frontend {
        [Admin Portal\n- Dashboard\n- Monitoring\n- Payments\n- Security] as admin
        [Customer Portal\n- Dashboard\n- Energy Data\n- Payments\n- System Status] as customer
    }
    note right of frontend
        React 19 + TypeScript
        REST API + WebSocket
        HTTPS/WSS Communication
    end note
}

package "Application Layer" <<application>> {
    component "Spring Boot 3.3.4 Backend" as backend {
        [User Management\n- Authentication\n- JWT Security\n- User Profiles] as usermgmt
        [Energy Monitoring\n- Data Ingestion\n- Summaries\n- WebSocket Push] as energy
        [Payment Compliance\n- Payment Plans\n- Payments\n- Reminders] as payment
        [Tamper Detection\n- Security Events\n- Alerts\n- Logs] as tamper
        [Service Control\n- Status Management\n- Device Commands\n- Integration] as service
    }
    note right of backend
        Java 21
        Spring Security + JWT
        SpringDoc OpenAPI 3
    end note
}

package "Persistence Layer" <<persistence>> {
    database "PostgreSQL 15" as db {
        [17 Tables\n- users\n- solar_installations\n- energy_data\n- payments\n- tamper_events\n- service_status\n- etc.] as tables
    }
    note right of db
        Production: PostgreSQL 15
        Dev/Test: H2 in-memory
        ORM: Spring Data JPA
    end note
}

admin -down-> usermgmt : REST/WebSocket
admin -down-> energy : REST/WebSocket
admin -down-> payment : REST/WebSocket
admin -down-> tamper : REST/WebSocket
admin -down-> service : REST/WebSocket

customer -down-> usermgmt : REST/WebSocket
customer -down-> energy : REST/WebSocket
customer -down-> payment : REST/WebSocket
customer -down-> service : REST/WebSocket

usermgmt -down-> tables : JDBC
energy -down-> tables : JDBC
payment -down-> tables : JDBC
tamper -down-> tables : JDBC
service -down-> tables : JDBC

@enduml
