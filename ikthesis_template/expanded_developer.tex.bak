\subsubsection{Core Database Tables}
\label{subsubsec:core-tables}

\paragraph{User Management Tables}

\textbf{users} - Central user account information
\begin{verbatim}
CREATE TABLE users (
    id BIGSERIAL PRIMARY KEY,
    username VARCHAR(50) UNIQUE NOT NULL,
    email VARCHAR(100) UNIQUE NOT NULL,
    password VARCHAR(255) NOT NULL,
    first_name VARCHAR(50) NOT NULL,
    last_name VARCHAR(50) NOT NULL,
    phone VARCHAR(20),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    last_login TIMESTAMP,
    is_active BOOLEAN DEFAULT TRUE
);
\end{verbatim}

\textbf{roles} - System role definitions
\begin{verbatim}
CREATE TABLE roles (
    id BIGSERIAL PRIMARY KEY,
    name VARCHAR(50) UNIQUE NOT NULL,
    description TEXT,
    permissions TEXT -- JSON array of permissions
);
\end{verbatim}

\textbf{user\_roles} - Many-to-many relationship between users and roles
\begin{verbatim}
CREATE TABLE user_roles (
    user_id BIGINT REFERENCES users(id) ON DELETE CASCADE,
    role_id BIGINT REFERENCES roles(id) ON DELETE CASCADE,
    assigned_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (user_id, role_id)
);
\end{verbatim}

\paragraph{Installation Management Tables}

\textbf{solar\_installations} - Solar installation details
\begin{verbatim}
CREATE TABLE solar_installations (
    id BIGSERIAL PRIMARY KEY,
    user_id BIGINT REFERENCES users(id) ON DELETE CASCADE,
    address TEXT NOT NULL,
    city VARCHAR(100) NOT NULL,
    state VARCHAR(50) NOT NULL,
    zip_code VARCHAR(20) NOT NULL,
    capacity_kw DECIMAL(10,2) NOT NULL,
    installation_date DATE NOT NULL,
    status VARCHAR(20) DEFAULT 'ACTIVE',
    device_token VARCHAR(255) UNIQUE,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
\end{verbatim}

\paragraph{Energy Monitoring Tables}

\textbf{energy\_data} - Real-time energy readings
\begin{verbatim}
CREATE TABLE energy_data (
    id BIGSERIAL PRIMARY KEY,
    installation_id BIGINT REFERENCES solar_installations(id),
    timestamp TIMESTAMP NOT NULL,
    power_generation_watts DECIMAL(10,2),
    power_consumption_watts DECIMAL(10,2),
    daily_yield_kwh DECIMAL(10,3),
    total_yield_kwh DECIMAL(10,3),
    battery_level DECIMAL(5,2),
    voltage DECIMAL(8,2),
    current_amps DECIMAL(8,3),
    temperature DECIMAL(5,2),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
\end{verbatim}

\textbf{energy\_summaries} - Aggregated energy data
\begin{verbatim}
CREATE TABLE energy_summaries (
    id BIGSERIAL PRIMARY KEY,
    installation_id BIGINT REFERENCES solar_installations(id),
    summary_date DATE NOT NULL,
    summary_type VARCHAR(10) NOT NULL, -- DAILY, WEEKLY, MONTHLY
    total_generated_kwh DECIMAL(12,3),
    total_consumed_kwh DECIMAL(12,3),
    peak_generation_watts DECIMAL(10,2),
    peak_consumption_watts DECIMAL(10,2),
    efficiency_percentage DECIMAL(5,2),
    revenue_generated DECIMAL(10,2),
    cost_saved DECIMAL(10,2),
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
\end{verbatim}

\paragraph{Payment Management Tables}

\textbf{payment\_plans} - Payment plan configurations
\begin{verbatim}
CREATE TABLE payment_plans (
    id BIGSERIAL PRIMARY KEY,
    installation_id BIGINT REFERENCES solar_installations(id),
    total_amount DECIMAL(12,2) NOT NULL,
    monthly_amount DECIMAL(10,2) NOT NULL,
    interest_rate DECIMAL(5,4) DEFAULT 0,
    term_months INTEGER NOT NULL,
    start_date DATE NOT NULL,
    status VARCHAR(20) DEFAULT 'ACTIVE',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
\end{verbatim}

\textbf{payments} - Individual payment records
\begin{verbatim}
CREATE TABLE payments (
    id BIGSERIAL PRIMARY KEY,
    payment_plan_id BIGINT REFERENCES payment_plans(id),
    amount DECIMAL(10,2) NOT NULL,
    due_date DATE NOT NULL,
    payment_date DATE,
    status VARCHAR(20) DEFAULT 'PENDING',
    payment_method VARCHAR(50),
    transaction_id VARCHAR(255),
    notes TEXT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
\end{verbatim}

\paragraph{Security and Monitoring Tables}

\textbf{tamper\_events} - Security incident tracking
\begin{verbatim}
CREATE TABLE tamper_events (
    id BIGSERIAL PRIMARY KEY,
    installation_id BIGINT REFERENCES solar_installations(id),
    event_type VARCHAR(50) NOT NULL,
    severity VARCHAR(20) NOT NULL, -- LOW, MEDIUM, HIGH, CRITICAL
    timestamp TIMESTAMP NOT NULL,
    description TEXT,
    device_info TEXT, -- JSON with device details
    location_data TEXT, -- JSON with GPS coordinates
    resolved BOOLEAN DEFAULT FALSE,
    resolved_by BIGINT REFERENCES users(id),
    resolved_at TIMESTAMP,
    resolution_notes TEXT,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
\end{verbatim}

\textbf{system\_heartbeats} - Device health monitoring
\begin{verbatim}
CREATE TABLE system_heartbeats (
    id BIGSERIAL PRIMARY KEY,
    installation_id BIGINT REFERENCES solar_installations(id),
    timestamp TIMESTAMP NOT NULL,
    device_status VARCHAR(20) NOT NULL,
    cpu_usage DECIMAL(5,2),
    memory_usage DECIMAL(5,2),
    disk_usage DECIMAL(5,2),
    network_signal INTEGER,
    firmware_version VARCHAR(50),
    last_restart TIMESTAMP,
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);
\end{verbatim}

\subsubsection{Database Constraints and Indexing Strategy}
\label{subsubsec:constraints-indexes}

\paragraph{Primary and Foreign Key Constraints}
All tables implement proper referential integrity through primary and foreign key constraints. Cascade delete operations are carefully configured to maintain data consistency while preventing orphaned records.

\paragraph{Check Constraints}
Business logic constraints are enforced at the database level:
\begin{verbatim}
-- Energy data validation
ALTER TABLE energy_data ADD CONSTRAINT check_positive_generation 
    CHECK (power_generation_watts >= 0);
ALTER TABLE energy_data ADD CONSTRAINT check_battery_level 
    CHECK (battery_level >= 0 AND battery_level <= 100);

-- Payment validation
ALTER TABLE payments ADD CONSTRAINT check_positive_amount 
    CHECK (amount > 0);
ALTER TABLE payment_plans ADD CONSTRAINT check_valid_term 
    CHECK (term_months > 0 AND term_months <= 360);

-- Installation capacity validation
ALTER TABLE solar_installations ADD CONSTRAINT check_capacity 
    CHECK (capacity_kw > 0 AND capacity_kw <= 1000);
\end{verbatim}

\paragraph{Performance Indexes}
Strategic indexing for optimal query performance:
\begin{verbatim}
-- Time-series data optimization
CREATE INDEX idx_energy_data_timestamp ON energy_data(timestamp);
CREATE INDEX idx_energy_data_installation_time 
    ON energy_data(installation_id, timestamp);

-- User lookup optimization
CREATE INDEX idx_users_email ON users(email);
CREATE INDEX idx_users_username ON users(username);

-- Payment processing optimization
CREATE INDEX idx_payments_due_date ON payments(due_date);
CREATE INDEX idx_payments_status ON payments(status);

-- Security monitoring optimization
CREATE INDEX idx_tamper_events_timestamp ON tamper_events(timestamp);
CREATE INDEX idx_tamper_events_severity ON tamper_events(severity);

-- Heartbeat monitoring optimization
CREATE INDEX idx_heartbeats_installation_time 
    ON system_heartbeats(installation_id, timestamp);
\end{verbatim}

\subsubsection{Data Partitioning Strategy}
\label{subsubsec:partitioning}

For large-scale deployments, time-series tables are partitioned by date to optimize query performance and maintenance operations:

\begin{verbatim}
-- Partition energy_data by month
CREATE TABLE energy_data_y2025m01 PARTITION OF energy_data
    FOR VALUES FROM ('2025-01-01') TO ('2025-02-01');
CREATE TABLE energy_data_y2025m02 PARTITION OF energy_data
    FOR VALUES FROM ('2025-02-01') TO ('2025-03-01');
-- Additional monthly partitions...

-- Partition system_heartbeats by week
CREATE TABLE heartbeats_y2025w01 PARTITION OF system_heartbeats
    FOR VALUES FROM ('2025-01-01') TO ('2025-01-08');
-- Additional weekly partitions...
\end{verbatim}



\section{API Documentation}
\label{sec:api-documentation}

The Solar Energy Monitoring and Control System exposes a comprehensive set of APIs for integration with other systems and for communication between internal components.

\subsection{API Design Principles}
\label{subsec:api-design}

The APIs are designed following RESTful principles:

\begin{itemize}
    \item \textbf{Resource-Oriented}: APIs are organized around resources, with URLs representing resource identifiers
    \item \textbf{HTTP Methods}: Standard HTTP methods (GET, POST, PUT, DELETE) for CRUD operations
    \item \textbf{Stateless}: Each request contains all necessary information for processing
    \item \textbf{JSON Format}: Standard JSON formatting for request and response bodies
    \item \textbf{Versioning}: API versioning to support backward compatibility
    \item \textbf{Error Handling}: Consistent error codes and messages across all endpoints
    \item \textbf{Pagination}: Standard pagination for large result sets
    \item \textbf{Filtering and Sorting}: Query parameters for filtering and sorting results
\end{itemize}

\subsection{API Overview}
\label{subsec:api-overview}

The Solar Energy Monitoring and Control System is built on a comprehensive RESTful API structure. The system is organized into several primary API domains, each serving a distinct functional area. Due to the extensive number of endpoints, only a brief overview of each API domain is provided here. Complete API documentation is available through the Swagger interface after starting the application.

\begin{description}
    \item[Energy Monitoring API] Enables submission and retrieval of energy production and consumption data. Provides endpoints for energy readings, summaries, and dashboard data.
    
    \item[Payment Compliance API] Manages financial transactions, payment plans, and billing operations. Includes endpoints for payment processing, plan management, and financial reporting.
    
    \item[Security and Tampering API] Handles security event reporting, tampering detection, and compliance monitoring. Offers endpoints for security alerts, audit logs, and compliance reporting.
    
    \item[System Monitoring API] Controls device health monitoring, heartbeat processing, and command management. Provides endpoints for status updates, logs, and remote device operations.
    
    \item[User Management API] Manages user authentication, authorization, and profile data. Includes endpoints for login, registration, profile management, and administrative user operations.
\end{description}

\subsection{API Documentation Access}
\label{subsec:api-access}

All API endpoints are comprehensively documented through Swagger UI, which is automatically available when the application is running. To access the complete API documentation:

\begin{enumerate}
    \item Start the Solar Energy Monitoring and Control System application
    \item Navigate to \texttt{http://localhost:8080/swagger-ui/index.html} in your web browser
    \item Explore the available endpoints, request/response formats, and try out API calls directly
\end{enumerate}

Swagger UI provides interactive documentation that allows developers to understand and test all available endpoints without needing to refer to static documentation.

\section{Testing}
\label{sec:testing-comprehensive}

This section provides comprehensive documentation of the testing strategies, methodologies, and analysis conducted for the Solar Energy Monitoring and Control System. The testing approach encompasses multiple levels of verification, from unit testing to system-wide performance analysis, ensuring both functional correctness and operational efficiency under various conditions.

\subsection{Testing Methodology and Framework}
\label{subsec:testing-methodology}

The testing methodology is built upon established software engineering principles, implementing a multi-layered testing strategy that ensures comprehensive coverage of system functionality, performance characteristics, and security requirements.

\subsubsection{Testing Strategy Overview}
\label{subsubsec:testing-strategy}

The testing framework employs a systematic approach based on the test pyramid methodology, adapted for the specific requirements of an energy monitoring system:

\begin{figure}[htbp]
\centering
\begin{verbatim}
                     End-to-End Tests
                    /                 \
                   /   User Workflows  \
                  /    Security Tests   \
                 /_____________________\
                
            Integration & API Tests
           /                         \
          /    Service Integration    \
         /     Database Operations    \
        /       External APIs        \
       /_____________________________\
      
                Unit Tests
           /              \
          /   Component    \
         /     Testing      \
        /   Business Logic  \
       /____________________\
\end{verbatim}
\caption{Testing Pyramid Architecture for Solar Energy System}
\label{fig:testing-pyramid}
\end{figure}

\textbf{Testing Framework Components:}
\begin{itemize}
    \item \textbf{Unit Testing Layer}: Validates individual components, business logic, and algorithms in isolation
    \item \textbf{Integration Testing Layer}: Verifies component interactions, database operations, and service communications
    \item \textbf{System Testing Layer}: Validates complete workflows, user scenarios, and system behavior under various conditions
    \item \textbf{Performance Testing Layer}: Analyzes system performance, scalability characteristics, and resource utilization
    \item \textbf{Security Testing Layer}: Validates authentication, authorization, data protection, and vulnerability resistance
\end{itemize}

\subsubsection{Technology Stack for Testing}
\label{subsubsec:testing-technologies}

\begin{table}[htbp]
\centering
\caption{Testing Technology Stack}
\label{tab:testing-technologies}
\begin{tabular}{|l|l|l|}
\hline
\textbf{Testing Layer} & \textbf{Technology/Framework} & \textbf{Primary Use Case} \\
\hline
Backend Unit Testing & JUnit 5, Mockito, AssertJ & Component isolation testing \\
\hline
Frontend Unit Testing & Jest, React Testing Library & Component and hook testing \\
\hline
Integration Testing & Spring Boot Test, TestContainers & Service integration validation \\
\hline
API Testing & MockMvc, WebTestClient & REST endpoint verification \\
\hline
Database Testing & H2 (in-memory), PostgreSQL & Data persistence validation \\
\hline
Performance Testing & JMeter, Spring Boot Actuator & Load and stress testing \\
\hline
Security Testing & Spring Security Test & Authentication/authorization \\
\hline
End-to-End Testing & Selenium, Playwright (planned) & Complete workflow validation \\
\hline
\end{tabular}
\end{table}

\subsection{Comprehensive Test Plan Documentation}
\label{subsec:test-plan-documentation}


\subsubsection{Test Case Design Methodology}
\label{subsubsec:test-case-design}

Test cases are designed following systematic methodologies to ensure comprehensive coverage:

\paragraph{Equivalence Partitioning and Boundary Value Analysis}

For each module, input domains are partitioned into equivalence classes, with particular attention to boundary conditions:

\textbf{Energy Monitoring Module Example:}
\begin{verbatim}
Energy Reading Input Validation:
+-- Valid Ranges (Equivalence Classes)
|   +-- Power Generation: 0 <= watts <= 50,000
|   +-- Power Consumption: 0 <= watts <= 20,000
|   +-- Voltage: 100V <= voltage <= 400V
|   +-- Timestamp: Current time ± 5 minutes
|
+-- Boundary Values
|   +-- Generation: {0, 1, 49999, 50000, 50001}
|   +-- Consumption: {0, 1, 19999, 20000, 20001}
|   +-- Voltage: {99, 100, 101, 399, 400, 401}
|   +-- Time: {now-301s, now-300s, now, now+300s, now+301s}
|
+-- Invalid Classes
    +-- Negative values
    +-- Null/missing fields
    +-- Malformed data types
    +-- Future timestamps > 5 minutes
\end{verbatim}

\paragraph{State-Based Testing}

For components with complex state management, state transition testing ensures all valid state changes are properly handled:

\textbf{Payment State Transitions:}
\begin{verbatim}
Payment Plan States:
PENDING → ACTIVE → {SUSPENDED, COMPLETED, CANCELLED}
    ↓        ↓            ↓         ↓         ↓
  [verify] [payment]  [overdue]  [paid]   [admin]
\end{verbatim}

\paragraph{Error Condition Testing}

Comprehensive error scenarios are tested to ensure graceful failure handling:

\begin{itemize}
    \item \textbf{Network Failures}: Connection timeouts, service unavailability
    \item \textbf{Data Corruption}: Malformed JSON, unexpected field types
    \item \textbf{Concurrency Issues}: Race conditions, deadlock scenarios
    \item \textbf{Resource Exhaustion}: Memory limits, connection pool depletion
    \item \textbf{Security Violations}: Unauthorized access attempts, token manipulation
\end{itemize}

\subsubsection{Module-Specific Test Plans}
\label{subsubsec:module-test-plans}

\paragraph{Energy Monitoring Module Test Plan}

\textbf{Objective}: Validate accurate energy data collection, processing, and storage with real-time performance requirements.

\textbf{Test Categories}:
\begin{enumerate}
    \item \textbf{Data Ingestion Testing}
    \begin{itemize}
        \item High-volume data processing (1000+ readings/second)
        \item Concurrent device submissions
        \item Data validation and sanitization
        \item Duplicate detection and handling
    \end{itemize}
    
    \item \textbf{Data Processing Testing}
    \begin{itemize}
        \item Real-time aggregation algorithms
        \item Historical data summarization
        \item Performance metric calculations
        \item Anomaly detection accuracy
    \end{itemize}
    
    \item \textbf{Data Retrieval Testing}
    \begin{itemize}
        \item Dashboard query performance
        \item Date range filtering accuracy
        \item Export functionality validation
        \item Pagination and sorting
    \end{itemize}
\end{enumerate}

\textbf{Test Data Specifications}:
\begin{verbatim}
Test Data Profiles:
+-- Residential Installation (5kW)
|   +-- Peak Generation: 4.5kW (11 AM - 2 PM)
|   +-- Average Consumption: 1.2kW
|   +-- Daily Patterns: Morning/evening usage spikes
|
+-- Commercial Installation (50kW)
|   +-- Peak Generation: 45kW (10 AM - 3 PM)
|   +-- Business Hours Consumption: 15-25kW
|   +-- Weekend Patterns: Reduced consumption
|
+-- Edge Cases
    +-- Zero generation (nighttime, maintenance)
    +-- Maximum generation (optimal conditions)
    +-- Rapid fluctuations (cloudy conditions)
    +-- System offline/recovery scenarios
\end{verbatim}

\paragraph{Payment Compliance Module Test Plan}

\textbf{Objective}: Ensure accurate payment processing, compliance verification, and service control operations.

\textbf{Test Categories}:
\begin{enumerate}
    \item \textbf{Payment Processing Testing}
    \begin{itemize}
        \item Transaction validation and verification
        \item External payment gateway integration
        \item Error handling and retry mechanisms
        \item Fraud detection and prevention
    \end{itemize}
    
    \item \textbf{Compliance Testing}
    \begin{itemize}
        \item Payment plan adherence monitoring
        \item Automatic service suspension/restoration
        \item Grace period calculations
        \item Notification and alert systems
    \end{itemize}
    
    \item \textbf{Financial Accuracy Testing}
    \begin{itemize}
        \item Payment calculation algorithms
        \item Interest and penalty computations
        \item Currency handling and precision
        \item Audit trail maintenance
    \end{itemize}
\end{enumerate}

\textbf{Payment Scenarios}:
\begin{verbatim}
Payment Test Scenarios:
+-- Standard Payments
|   +-- On-time monthly payments
|   +-- Early payment discounts
|   +-- Partial payment handling
|   +-- Payment method variations
|
+-- Delinquency Scenarios
|   +-- Late payment penalties
|   +-- Grace period management
|   +-- Progressive service restrictions
|   +-- Account recovery processes
|
+-- Edge Cases
    +-- Payment reversals and refunds
    +-- Account transfer scenarios
    +-- System downtime during payment
    +-- Duplicate payment prevention
\end{verbatim}

\paragraph{Security and Tampering Detection Test Plan}

\textbf{Objective}: Validate security mechanisms, intrusion detection, and system integrity protection.

\textbf{Test Categories}:
\begin{enumerate}
    \item \textbf{Authentication Testing}
    \begin{itemize}
        \item User login security validation
        \item JWT token lifecycle management
        \item Multi-factor authentication scenarios
        \item Session timeout and renewal
    \end{itemize}
    
    \item \textbf{Authorization Testing}
    \begin{itemize}
        \item Role-based access control validation
        \item Resource permission verification
        \item Privilege escalation prevention
        \item Cross-tenant data isolation
    \end{itemize}
    
    \item \textbf{Tampering Detection Testing}
    \begin{itemize}
        \item Physical tampering simulation
        \item Digital signature verification
        \item Anomalous behavior detection
        \item Alert generation and escalation
    \end{itemize}
\end{enumerate}

\textbf{Security Test Scenarios}:
\begin{verbatim}
Security Attack Simulations:
+-- Authentication Attacks
|   +-- Brute force login attempts
|   +-- Token hijacking and replay
|   +-- Session fixation attacks
|   +-- Password policy validation
|
+-- Authorization Bypasses
|   +-- Direct object reference
|   +-- Function level access control
|   +-- Insecure direct object references
|   +-- Missing authorization checks
|
+-- Tampering Scenarios
|   +-- Physical device manipulation
|   +-- Data payload modification
|   +-- Communication interception
|   +-- Firmware integrity violations
|
+-- Input Validation
    +-- SQL injection attempts
    +-- Cross-site scripting (XSS)
    +-- Command injection
    +-- File upload vulnerabilities
\end{verbatim}

\subsection{Detailed Test Case Documentation}
\label{subsec:detailed-test-cases}

This section provides comprehensive documentation of test cases organized by functional area and complexity level.

\subsubsection{Energy Monitoring Test Cases}
\label{subsubsec:energy-test-cases-detailed}

\paragraph{Unit Test Cases - Energy Service Layer}

\textbf{TC-EM-001: Energy Reading Processing}
\begin{verbatim}
Test Case ID: TC-EM-001
Description: Validate energy reading processing with valid input data
Prerequisites: Active installation exists in database

Test Steps:
1. Create valid EnergyReading object with:
   - installationId: 1L
   - powerGenerationWatts: 5000.0
   - powerConsumptionWatts: 3000.0
   - voltage: 240.0
   - timestamp: current time

2. Mock dependencies:
   - installationRepository.findById(1L) returns active installation
   - readingRepository.save() returns saved reading

3. Call energyService.processEnergyReading(reading)

Expected Results:
- Method returns non-null EnergyReading
- Reading contains all input values
- Repository save method called exactly once
- Installation validation performed

Actual Results: [Pass/Fail with details]
Test Data: Valid energy reading with realistic values
\end{verbatim}

\textbf{TC-EM-002: Invalid Installation Handling}
\begin{verbatim}
Test Case ID: TC-EM-002
Description: Verify proper error handling for non-existent installation
Prerequisites: Database with no installation ID 999

Test Steps:
1. Create EnergyReading with installationId: 999L
2. Mock installationRepository.findById(999L) returns empty Optional
3. Call energyService.processEnergyReading(reading)

Expected Results:
- EntityNotFoundException thrown
- Exception message contains installation ID
- No data saved to database
- Proper error logging performed

Validation Criteria:
- Exception type: EntityNotFoundException
- Error message: "Installation not found: 999"
- Repository save not called
\end{verbatim}

\textbf{TC-EM-003: Data Validation Edge Cases}
\begin{verbatim}
Test Case ID: TC-EM-003
Description: Test boundary conditions and data validation
Test Matrix:

Input Combinations:
+-- Boundary Values
|   +-- Generation: 0W, 50000W, 50001W (invalid)
|   +-- Consumption: 0W, 20000W, 20001W (invalid)
|   +-- Voltage: 100V, 400V, 401V (invalid)
|   +-- Time: past 5min, current, future 5min, future 6min (invalid)
|
+-- Invalid Data Types
|   +-- Negative power values
|   +-- Null required fields
|   +-- Invalid timestamps
|   +-- Malformed numeric values
|
+-- Edge Conditions
    +-- Zero generation (nighttime scenario)
    +-- Maximum rated output
    +-- Consumption exceeding generation
    +-- Voltage fluctuations
\end{verbatim}

\paragraph{Integration Test Cases - Energy API Layer}

\textbf{TC-EM-101: Energy Data Submission API}
