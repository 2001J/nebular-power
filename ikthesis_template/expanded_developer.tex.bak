\subsubsection{User Management Module Implementation}
\label{subsubsec:user-management-implementation}

The User Management module implements comprehensive authentication and authorization using Spring Security with JWT tokens.

\paragraph{Authentication Implementation}

The authentication system is implemented in \texttt{src/main/java/com/solar/user\_management/controller/AuthController.java}:

\begin{verbatim}
@RestController
@RequestMapping("/api/auth")
@CrossOrigin(origins = "*", maxAge = 3600)
@RequiredArgsConstructor
@Tag(name = "Authentication", description = "Authentication API")
public class AuthController {

    private final UserService userService;
    private final UserActivityLogService activityLogService;

    @PostMapping("/login")
    @Operation(summary = "Login user", 
              description = "Authenticates a user and returns an authentication token")
    public ResponseEntity<AuthResponse> login(@Valid @RequestBody LoginRequest loginRequest) {
        // Authenticate user
        AuthResponse response = userService.authenticateUser(loginRequest);
        
        // Update last login timestamp
        userService.updateLastLogin(loginRequest.getEmail());
        
        return ResponseEntity.ok(response);
    }
\end{verbatim}

The JWT token implementation is handled in \texttt{src/main/java/com/solar/user\_management/security/JwtTokenProvider.java} with the following key features:

\begin{verbatim}
@Component
public class JwtTokenProvider {
    private final Key jwtSecret;
    private final int jwtExpirationInMs;

    public JwtTokenProvider(@Value("${jwt.secret}") String jwtSecret,
                           @Value("${jwt.expiration}") int jwtExpirationInMs) {
        // Using HS512 with secure key generation
        this.jwtSecret = Keys.secretKeyFor(SignatureAlgorithm.HS512);
        this.jwtExpirationInMs = jwtExpirationInMs;
    }

    public String generateToken(Authentication authentication) {
        UserDetails userPrincipal = (UserDetails) authentication.getPrincipal();
        Date expiryDate = new Date(System.currentTimeMillis() + jwtExpirationInMs);
        
        return Jwts.builder()
                .setSubject(userPrincipal.getUsername())
                .setIssuedAt(new Date())
                .setExpiration(expiryDate)
                .signWith(jwtSecret, SignatureAlgorithm.HS512)
                .compact();
    }
}
\end{verbatim}

Security configuration is implemented in \texttt{src/main/java/com/solar/user\_management/security/} with:
\begin{itemize}
    \item \textbf{JWT Authentication Filter}: \texttt{JwtAuthenticationFilter.java}
    \item \textbf{Custom User Details Service}: \texttt{CustomUserDetailsService.java}
    \item \textbf{Password Change Filter}: \texttt{PasswordChangeRequiredFilter.java}
    \item \textbf{JWT Configuration}: 24-hour expiration time as configured in \texttt{application.properties} line 61
\end{itemize}
        
        return ResponseEntity.ok(AuthenticationResponse.builder()
            .accessToken(newAccessToken)
            .refreshToken(newRefreshToken)
            .expiresIn(jwtService.getExpirationTime())
            .build());
    }
}
\end{verbatim}

\paragraph{Role-Based Authorization Implementation}
\begin{verbatim}
@Configuration
@EnableWebSecurity
@EnableMethodSecurity(prePostEnabled = true)
public class SecurityConfiguration {
    
    @Bean
    public SecurityFilterChain filterChain(HttpSecurity http) throws Exception {
        http
            .csrf(csrf -> csrf.disable())
            .cors(cors -> cors.configurationSource(corsConfigurationSource()))
            .sessionManagement(session -> 
                session.sessionCreationPolicy(SessionCreationPolicy.STATELESS))
            .authorizeHttpRequests(authz -> authz
                // Public endpoints
                .requestMatchers("/auth/**", "/public/**").permitAll()
                
                // Admin-only endpoints
                .requestMatchers("/admin/**").hasRole("ADMIN")
                .requestMatchers(HttpMethod.POST, "/monitoring/installations")
                    .hasRole("ADMIN")
                .requestMatchers(HttpMethod.DELETE, "/monitoring/**")
                    .hasRole("ADMIN")
                
                // Customer accessible endpoints
                .requestMatchers(HttpMethod.GET, "/monitoring/energy/**")
                    .hasAnyRole("ADMIN", "CUSTOMER")
                .requestMatchers(HttpMethod.POST, "/payments/process")
                    .hasAnyRole("ADMIN", "CUSTOMER")
                
                // Device endpoints (token-based authentication)
                .requestMatchers("/device/**").hasRole("DEVICE")
                
                // All other endpoints require authentication
                .anyRequest().authenticated()
            )
            .addFilterBefore(jwtAuthenticationFilter, 
                UsernamePasswordAuthenticationFilter.class)
            .exceptionHandling(exceptions -> exceptions
                .authenticationEntryPoint(authenticationEntryPoint)
                .accessDeniedHandler(accessDeniedHandler)
            );
        
        return http.build();
    }
}
\end{verbatim}

\subsubsection{Energy Monitoring Module Implementation}
\label{subsubsec:energy-monitoring-implementation}

The Energy Monitoring module handles real-time data collection, processing, and analytics for solar installations.

\paragraph{Real-Time Data Processing Implementation}
\begin{verbatim}
@Service
@Transactional
public class EnergyService {
    
    private final EnergyReadingRepository energyReadingRepository;
    private final InstallationRepository installationRepository;
    private final WebSocketMessagingService messagingService;
    private final EventPublisher eventPublisher;
    
    public EnergyReading processEnergyReading(
            @Valid EnergyReadingRequest request) {
        
        // Validate installation and device
        Installation installation = installationRepository
            .findById(request.getInstallationId())
            .orElseThrow(() -> new EntityNotFoundException(
                "Installation not found: " + request.getInstallationId()));
        
        validateDeviceToken(installation, request.getDeviceToken());
        
        // Create energy reading entity
        EnergyReading reading = EnergyReading.builder()
            .installation(installation)
            .timestamp(request.getTimestamp())
            .powerGenerationWatts(request.getPowerGenerationWatts())
            .powerConsumptionWatts(request.getPowerConsumptionWatts())
            .dailyYieldKWh(request.getDailyYieldKWh())
            .totalYieldKWh(request.getTotalYieldKWh())
            .batteryLevel(request.getBatteryLevel())
            .voltage(request.getVoltage())
            .currentAmps(request.getCurrentAmps())
            .temperatureCelsius(request.getTemperatureCelsius())
            .build();
        
        // Validate data ranges
        validateEnergyData(reading);
        
        // Save to database
        EnergyReading savedReading = energyReadingRepository.save(reading);
        
        // Publish events for other modules
        eventPublisher.publishEvent(new EnergyDataReceivedEvent(savedReading));
        
        // Send real-time updates to connected clients
        messagingService.sendEnergyUpdate(installation.getCustomer().getId(), 
            savedReading);
        
        // Check for anomalies
        analyzeForAnomalies(savedReading);
        
        return savedReading;
    }
    
    private void validateEnergyData(EnergyReading reading) {
        if (reading.getPowerGenerationWatts() < 0) {
            throw new ValidationException("Power generation cannot be negative");
        }
        
        if (reading.getBatteryLevel() < 0 || reading.getBatteryLevel() > 100) {
            throw new ValidationException("Battery level must be between 0 and 100");
        }
        
        if (reading.getVoltage() < 0 || reading.getVoltage() > 1000) {
            throw new ValidationException("Voltage reading out of acceptable range");
        }
    }
    
    private void analyzeForAnomalies(EnergyReading reading) {
        // Implement anomaly detection logic
        double expectedGeneration = calculateExpectedGeneration(reading);
        double actualGeneration = reading.getPowerGenerationWatts();
        
        if (Math.abs(actualGeneration - expectedGeneration) / expectedGeneration > 0.3) {
            eventPublisher.publishEvent(new EnergyAnomalyDetectedEvent(
                reading, expectedGeneration, actualGeneration));
        }
    }
}
\end{verbatim}

\paragraph{WebSocket Configuration for Real-Time Updates}
\begin{verbatim}
@Configuration
@EnableWebSocket
public class WebSocketConfig implements WebSocketConfigurer {
    
    private final JwtService jwtService;
    private final UserDetailsService userDetailsService;
    
    @Override
    public void registerWebSocketHandlers(WebSocketHandlerRegistry registry) {
        registry.addHandler(new EnergyDataWebSocketHandler(), "/ws/energy")
            .addInterceptors(new JwtWebSocketInterceptor(jwtService, userDetailsService))
            .setAllowedOrigins("http://localhost:3000", "https://yourdomain.com");
    }
}

@Component
public class EnergyDataWebSocketHandler extends TextWebSocketHandler {
    
    private final Map<String, WebSocketSession> sessions = new ConcurrentHashMap<>();
    private final ObjectMapper objectMapper;
    
    @Override
    public void afterConnectionEstablished(WebSocketSession session) throws Exception {
        String userId = getUserIdFromSession(session);
        sessions.put(userId, session);
        log.info("WebSocket connection established for user: {}", userId);
    }
    
    @Override
    public void afterConnectionClosed(WebSocketSession session, CloseStatus status) 
            throws Exception {
        String userId = getUserIdFromSession(session);
        sessions.remove(userId);
        log.info("WebSocket connection closed for user: {}", userId);
    }
    
    public void sendEnergyUpdate(Long userId, EnergyReading reading) {
        WebSocketSession session = sessions.get(userId.toString());
        if (session != null && session.isOpen()) {
            try {
                EnergyUpdateMessage message = EnergyUpdateMessage.builder()
                    .type("ENERGY_UPDATE")
                    .installationId(reading.getInstallation().getId())
                    .timestamp(reading.getTimestamp())
                    .powerGeneration(reading.getPowerGenerationWatts())
                    .powerConsumption(reading.getPowerConsumptionWatts())
                    .batteryLevel(reading.getBatteryLevel())
                    .build();
                
                session.sendMessage(new TextMessage(
                    objectMapper.writeValueAsString(message)));
            } catch (Exception e) {
                log.error("Error sending WebSocket message", e);
            }
        }
    }
}
\end{verbatim>
\subsubsection{Payment Compliance Module Implementation}
\label{subsubsec:payment-compliance-implementation}

The Payment Compliance module handles billing cycles, payment processing, and compliance monitoring with automated grace period management.

\paragraph{Payment Processing Implementation}
\begin{verbatim}
@Service
@Transactional
public class PaymentService {
    
    public PaymentResult processPayment(@Valid PaymentRequest request) {
        
        // Validate payment plan
        PaymentPlan paymentPlan = paymentPlanRepository
            .findById(request.getPaymentPlanId())
            .orElseThrow(() -> new EntityNotFoundException("Payment plan not found"));
        
        // Create payment record
        Payment payment = Payment.builder()
            .paymentPlan(paymentPlan)
            .amount(request.getAmount())
            .paymentMethod(request.getPaymentMethod())
            .status(PaymentStatus.PENDING)
            .dueDate(request.getDueDate())
            .build();
        
        try {
            // Process payment with external provider (simulated)
            PaymentProcessorResponse response = processWithExternalProvider(request);
            
            payment.setTransactionId(response.getTransactionId());
            payment.setPaymentDate(Instant.now());
            payment.setStatus(response.isSuccessful() ? 
                PaymentStatus.PAID : PaymentStatus.FAILED);
            payment.setPaymentProcessorResponse(response.toJson());
            
            paymentRepository.save(payment);
            
            // Update compliance status
            if (response.isSuccessful()) {
                updateComplianceStatus(paymentPlan.getInstallation(), payment);
                eventPublisher.publishEvent(new PaymentSuccessfulEvent(payment));
            } else {
                eventPublisher.publishEvent(new PaymentFailedEvent(payment, 
                    response.getErrorMessage()));
            }
            
            return PaymentResult.builder()
                .success(response.isSuccessful())
                .transactionId(response.getTransactionId())
                .message(response.getMessage())
                .build();
                
        } catch (PaymentProcessingException e) {
            payment.setStatus(PaymentStatus.FAILED);
            paymentRepository.save(payment);
            
            log.error("Payment processing failed for plan: {}", 
                paymentPlan.getId(), e);
            
            return PaymentResult.builder()
                .success(false)
                .message("Payment processing failed: " + e.getMessage())
                .build();
        }
    }
    
    @Scheduled(cron = "0 0 2 * * ?") // Daily at 2 AM
    public void processAutomaticBilling() {
        log.info("Starting automatic billing process");
        
        List<PaymentPlan> activePlans = paymentPlanRepository
            .findActivePaymentPlansWithUpcomingDue();
        
        for (PaymentPlan plan : activePlans) {
            try {
                generateNextPayment(plan);
            } catch (Exception e) {
                log.error("Failed to generate payment for plan: {}", 
                    plan.getId(), e);
            }
        }
        
        log.info("Automatic billing process completed for {} plans", 
            activePlans.size());
    }
    
    private void updateComplianceStatus(Installation installation, Payment payment) {
        ComplianceStatus status = complianceStatusRepository
            .findByInstallation(installation)
            .orElse(ComplianceStatus.builder()
                .installation(installation)
                .status("COMPLIANT")
                .complianceScore(100)
                .build());
        
        status.setLastPaymentDate(payment.getPaymentDate().toLocalDate());
        status.setLastUpdated(Instant.now());
        
        // Calculate next payment due date
        LocalDate nextDue = calculateNextPaymentDate(payment.getPaymentPlan());
        status.setNextPaymentDue(nextDue);
        
        // Reset overdue amount if payment covers it
        if (payment.getAmount().compareTo(status.getOverdueAmount()) >= 0) {
            status.setOverdueAmount(BigDecimal.ZERO);
            status.setStatus("COMPLIANT");
            status.setComplianceScore(100);
        }
        
        complianceStatusRepository.save(status);
    }
}
\end{verbatim}

\paragraph{Compliance Monitoring Implementation}
\begin{verbatim}
@Service
public class ComplianceService {
    
    @Scheduled(cron = "0 0 1 * * ?") // Daily at 1 AM
    public void monitorPaymentCompliance() {
        log.info("Starting payment compliance monitoring");
        
        List<ComplianceStatus> allStatuses = complianceStatusRepository.findAll();
        
        for (ComplianceStatus status : allStatuses) {
            evaluateComplianceStatus(status);
        }
        
        log.info("Compliance monitoring completed for {} installations", 
            allStatuses.size());
    }
    
    private void evaluateComplianceStatus(ComplianceStatus status) {
        LocalDate today = LocalDate.now();
        LocalDate nextDue = status.getNextPaymentDue();
        LocalDate gracePeriodEnd = status.getGracePeriodEnd();
        
        if (nextDue != null && nextDue.isBefore(today)) {
            // Payment is overdue
            if (gracePeriodEnd != null && gracePeriodEnd.isBefore(today)) {
                // Grace period has expired
                handleGracePeriodExpired(status);
            } else if (gracePeriodEnd == null) {
                // Start grace period
                startGracePeriod(status);
            }
        } else if ("NON_COMPLIANT".equals(status.getStatus()) && 
                   nextDue != null && !nextDue.isBefore(today)) {
            // Payment is current again
            restoreCompliance(status);
        }
    }
    
    private void handleGracePeriodExpired(ComplianceStatus status) {
        status.setStatus("NON_COMPLIANT");
        status.setComplianceScore(Math.max(0, status.getComplianceScore() - 25));
        
        // Calculate overdue amount
        PaymentPlan plan = status.getInstallation().getPaymentPlan();
        if (plan != null) {
            BigDecimal overdueAmount = plan.getMonthlyAmount();
            status.setOverdueAmount(status.getOverdueAmount().add(overdueAmount));
        }
        
        complianceStatusRepository.save(status);
        
        // Publish compliance violation event
        eventPublisher.publishEvent(new ComplianceViolationEvent(
            status.getInstallation(), "Grace period expired"));
        
        // Send notification
        notificationService.sendComplianceViolationNotification(status);
        
        log.warn("Grace period expired for installation: {}", 
            status.getInstallation().getId());
    }
}
\end{verbatim}

\subsubsection{Security and Tampering Detection Implementation}
\label{subsubsec:security-implementation}

The Security module implements sophisticated tamper detection algorithms and automated incident response.

\paragraph{Tamper Detection Implementation}
\begin{verbatim}
@Service
@Transactional
public class TamperDetectionService {
    
    public void processTamperEvent(@Valid TamperEventRequest request) {
        
        // Validate installation
        Installation installation = installationRepository
            .findById(request.getInstallationId())
            .orElseThrow(() -> new EntityNotFoundException(
                "Installation not found: " + request.getInstallationId()));
        
        // Create tamper event
        TamperEvent tamperEvent = TamperEvent.builder()
            .installation(installation)
            .tamperType(request.getTamperType())
            .detectedAt(request.getDetectedAt())
            .confidenceScore(request.getConfidenceScore())
            .sensorData(request.getSensorData())
            .acknowledged(false)
            .build();
        
        // Analyze tamper event severity
        TamperSeverity severity = analyzeTamperSeverity(tamperEvent);
        
        // Save tamper event
        tamperEvent = tamperEventRepository.save(tamperEvent);
        
        // Create security event
        SecurityEvent securityEvent = SecurityEvent.builder()
            .installation(installation)
            .eventType("TAMPER_DETECTED")
            .severity(severity.name())
            .description(String.format("Tamper detected: %s with confidence %.2f%%",
                request.getTamperType(), request.getConfidenceScore()))
            .eventTimestamp(request.getDetectedAt())
            .resolved(false)
            .metadata(request.getSensorData())
            .build();
        
        securityEventRepository.save(securityEvent);
        
        // Trigger automated response
        triggerAutomatedResponse(tamperEvent, severity);
        
        // Publish event for other modules
        eventPublisher.publishEvent(new TamperDetectedEvent(tamperEvent, severity));
        
        log.warn("Tamper event detected for installation {}: {} (confidence: {}%)",
            installation.getId(), request.getTamperType(), 
            request.getConfidenceScore());
    }
    
    private TamperSeverity analyzeTamperSeverity(TamperEvent event) {
        double confidence = event.getConfidenceScore().doubleValue();
        String tamperType = event.getTamperType();
        
        // High-risk tamper types
        if (Arrays.asList("PHYSICAL_DAMAGE", "CABLE_CUT", "PANEL_REMOVAL")
                .contains(tamperType)) {
            return confidence >= 80 ? TamperSeverity.CRITICAL : TamperSeverity.HIGH;
        }
        
        // Medium-risk tamper types
        if (Arrays.asList("VIBRATION_ANOMALY", "TEMPERATURE_ANOMALY")
                .contains(tamperType)) {
            return confidence >= 90 ? TamperSeverity.HIGH : 
                   confidence >= 70 ? TamperSeverity.MEDIUM : TamperSeverity.LOW;
        }
        
        // Default classification based on confidence
        if (confidence >= 95) return TamperSeverity.HIGH;
        if (confidence >= 80) return TamperSeverity.MEDIUM;
        return TamperSeverity.LOW;
    }
    
    private void triggerAutomatedResponse(TamperEvent event, TamperSeverity severity) {
        switch (severity) {
            case CRITICAL:
                // Immediate alert to admin and customer
                alertService.sendImmediateAlert(event);
                // Disable system if configured
                if (isAutomaticDisableEnabled(event.getInstallation())) {
                    serviceControlService.disableInstallation(
                        event.getInstallation().getId(), 
                        "Automatic disable due to critical tamper event");
                }
                break;
                
            case HIGH:
                // Send alert to admin
                alertService.sendHighPriorityAlert(event);
                // Log for investigation
                investigationService.createInvestigationCase(event);
                break;
                
            case MEDIUM:
                // Send notification
                notificationService.sendTamperNotification(event);
                break;
                
            case LOW:
                // Log only
                auditService.logTamperEvent(event);
                break;
        }
    }
}
\end{verbatim}

\subsubsection{Service Control Module Implementation}
\label{subsubsec:service-control-implementation}

The Service Control module manages device communications, health monitoring, and system operations.

\paragraph{Heartbeat Processing Implementation}
\begin{verbatim}
@Service
@Transactional
public class HeartbeatService {
    
    public void processHeartbeat(@Valid HeartbeatRequest request) {
        
        // Validate installation
        Installation installation = installationRepository
            .findById(request.getInstallationId())
            .orElseThrow(() -> new EntityNotFoundException(
                "Installation not found: " + request.getInstallationId()));
        
        // Create heartbeat record
        DeviceHeartbeat heartbeat = DeviceHeartbeat.builder()
            .installation(installation)
            .heartbeatTimestamp(request.getTimestamp())
            .deviceStatus(request.getDeviceStatus())
            .systemHealth(request.getSystemHealth())
            .cpuUsage(request.getCpuUsage())
            .memoryUsage(request.getMemoryUsage())
            .diskUsage(request.getDiskUsage())
            .networkStatus(request.getNetworkStatus())
            .uptimeSeconds(request.getUptimeSeconds())
            .firmwareVersion(request.getFirmwareVersion())
            .build();
        
        deviceHeartbeatRepository.save(heartbeat);
        
        // Update installation status
        updateInstallationStatus(installation, heartbeat);
        
        // Analyze system health
        analyzeSystemHealth(heartbeat);
        
        // Publish heartbeat event
        eventPublisher.publishEvent(new HeartbeatReceivedEvent(heartbeat));
        
        log.debug("Heartbeat processed for installation: {}", 
            installation.getId());
    }
    
    @Scheduled(fixedRate = 300000) // Every 5 minutes
    public void detectOfflineDevices() {
        Instant cutoffTime = Instant.now().minus(Duration.ofMinutes(15));
        
        List<Installation> potentiallyOfflineInstallations = 
            installationRepository.findInstallationsWithoutRecentHeartbeat(cutoffTime);
        
        for (Installation installation : potentiallyOfflineInstallations) {
            handleOfflineDevice(installation);
        }
    }
    
    private void analyzeSystemHealth(DeviceHeartbeat heartbeat) {
        List<String> healthIssues = new ArrayList<>();
        
        // CPU usage check
        if (heartbeat.getCpuUsage() != null && 
            heartbeat.getCpuUsage().doubleValue() > 90) {
            healthIssues.add("High CPU usage: " + heartbeat.getCpuUsage() + "%");
        }
        
        // Memory usage check
        if (heartbeat.getMemoryUsage() != null && 
            heartbeat.getMemoryUsage().doubleValue() > 85) {
            healthIssues.add("High memory usage: " + heartbeat.getMemoryUsage() + "%");
        }
        
        // Disk usage check
        if (heartbeat.getDiskUsage() != null && 
            heartbeat.getDiskUsage().doubleValue() > 95) {
            healthIssues.add("High disk usage: " + heartbeat.getDiskUsage() + "%");
        }
        
        // Network status check
        if (!"CONNECTED".equals(heartbeat.getNetworkStatus())) {
            healthIssues.add("Network connectivity issues: " + 
                heartbeat.getNetworkStatus());
        }
        
        if (!healthIssues.isEmpty()) {
            createHealthAlert(heartbeat.getInstallation(), healthIssues);
        }
    }
    
    private void handleOfflineDevice(Installation installation) {
        // Check if already marked as offline
        if ("OFFLINE".equals(installation.getStatus())) {
            return;
        }
        
        // Mark as offline
        installation.setStatus("OFFLINE");
        installationRepository.save(installation);
        
        // Create operational log
        OperationalLog log = OperationalLog.builder()
            .installation(installation)
            .logLevel("WARN")
            .component("HEARTBEAT_MONITOR")
            .message("Device went offline - no heartbeat received in 15 minutes")
            .timestamp(Instant.now())
            .build();
        
        operationalLogRepository.save(log);
        
        // Send offline notification
        notificationService.sendDeviceOfflineNotification(installation);
        
        // Publish offline event
        eventPublisher.publishEvent(new DeviceOfflineEvent(installation));
        
        log.warn("Device marked as offline: {}", installation.getId());
    }
}
\end{verbatim}

