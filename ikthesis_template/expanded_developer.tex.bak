            \item \textbf{Model Layer}: Entity definitions in \texttt{*/model/} packages (e.g., \texttt{User.java})
            \item \textbf{DTO Layer}: Data transfer objects in \texttt{*/dto/} packages for API communication
            \item \textbf{Security Layer}: Authentication logic in \texttt{user\_management/security/} package
            \item \textbf{Configuration Layer}: Spring configuration in \texttt{*/config/} packages
        \end{itemize}
\end{itemize}

