# Solar Monitoring System - Essential Configuration
# ===============================================
# Edit this file with your own settings before starting the system

# ADMIN USER (Required)
# ---------------------
# This is the main administrator account for the system
ADMIN_EMAIL=admin@solar.com
ADMIN_PASSWORD=admin123
ADMIN_FULL_NAME=System Administrator

# CUSTOMER USER (Optional)
# ------------------------
# You can create an initial customer user or add users later through the admin interface
# Uncomment and modify these lines if you want to create an initial customer
# DEMO_CUSTOMER1_EMAIL=customer@example.com
# DEMO_CUSTOMER1_PASSWORD=customer-password
# DEMO_CUSTOMER1_FULL_NAME=Customer Name

# INSTALLATION (Optional)
# -----------------------
# You can create an initial solar installation or add installations later through the interface
# Uncomment and modify these lines if you want to create an initial installation
# DEFAULT_INSTALLATION1_NAME=My Solar Installation
# DEFAULT_INSTALLATION1_LOCATION=123 My Address, City, Country
# DEFAULT_INSTALLATION1_CAPACITY=5.5
# DEFAULT_INSTALLATION1_TYPE=RESIDENTIAL
# DEFAULT_INSTALLATION1_OWNER=customer@example.com

# SECURITY SETTINGS (Required)
# ----------------------------
# JWT secret key MUST be at least 64 characters for HS512 algorithm
# Generate one with: openssl rand -base64 64 | tr -d '\n' | head -c 64
JWT_SECRET=change-this-to-a-secure-64-character-minimum-random-string-value
JWT_EXPIRATION_MS=86400000

# DATABASE (Docker defaults; override here if needed)
# --------------------------------------------------
# These values are used by docker compose for Postgres and the backend
DB_HOST=postgres
DB_PORT=5432
DB_NAME=solardb
DB_USER=solaruser
DB_PASSWORD=secret

# OPTIONAL: Host port mapping for Postgres container (host:container)
# Change only if 5433 clashes on your machine
POSTGRES_HOST_PORT=5433

# OPTIONAL: Host port mapping for Backend container (host:container)
# Change only if 8080 clashes on your machine
BACKEND_HOST_PORT=8080

# OPTIONAL: Host port mapping for Frontend container (host:container)
# Change only if 3000 clashes on your machine
FRONTEND_HOST_PORT=3000

# DEMO DATA
# ---------
# Set to false to disable creating demo data
INIT_DEMO_DATA=false

# MAIL (Optional for local; required for production)
# --------------------------------------------------
# If you plan to test emails, set these to a real SMTP service
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=test@example.com
MAIL_PASSWORD=your-app-password-here

# URLs
# ----
# These are automatically generated from the HOST_PORT values above
# No need to manually set these - they will be constructed as:
#   FRONTEND_URL=http://localhost:${FRONTEND_HOST_PORT}
#   BACKEND_URL=http://localhost:${BACKEND_HOST_PORT}

# Spring profile
# --------------
SPRING_PROFILES_ACTIVE=prod